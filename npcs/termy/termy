#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import sys
import subprocess
from pathlib import Path

from FlintNPC import load_json
import learned
import on_demand
from providers.lmstudio import LmStudioProvider
from providers.local import LocalProvider
from tui.tools import TuiTools, BOLD, GRAY, GREEN, RED, RESET, YELLOW

tui = TuiTools()

def is_uncertain(result: dict, threshold: float) -> bool:
    """True when TERMy has no match, or a probabilistic match it should not trust."""
    status = str(result.get("status", "rejected")).lower()
    if status == "rejected":
        return True
    if "probabilistic" not in status:
        return False
    return result.get("confidence", 0.0) < threshold or bool(result.get("ignored_words"))

def uncertainty_note(result: dict) -> str:
    if str(result.get("status", "rejected")).lower() == "rejected":
        return "TERMy has no match."
    ignored = result.get("ignored_words") or []
    detail = f", ignored: {', '.join(ignored)}" if ignored else ""
    return f"TERMy is not sure ({result.get('confidence', 0.0):.0%}{detail})."

def with_helpers(command: str, scripts_dir: Path) -> str:
    """Prefixes the command with the TERMy shell helpers."""
    sources = [f"source {f}" for f in sorted(scripts_dir.iterdir()) if f.suffix == ".sh"] if scripts_dir.is_dir() else []
    return " && ".join(sources + [command])

def llm_fallback(llm_config: dict, config: dict, user_input: str, result: dict, scripts_dir: Path, yes: bool):
    """Asks LM Studio for a command. Returns an exit code, or None when LM Studio is missing."""
    provider = LmStudioProvider(llm_config)
    print(f"{YELLOW}{uncertainty_note(result)} Asking {provider.model}...{RESET}\n")
    if not provider.ensure_ready():
        print(f"{GRAY}LM Studio is not installed, so TERMy cannot ask an LLM.{RESET}\n")
        return None
    suggestion = provider.suggest(user_input)
    if not suggestion:
        print(f"{RED}{provider.model} gave no command.{RESET}\n")
        return 1
    command, explanation = suggestion["command"], suggestion["explanation"]
    print(f"{GREEN}{BOLD}{command}{RESET}{GRAY}\n\nDescription: {explanation}\n{RESET}")
    if not (yes or tui.confirm()):
        return 0
    try:
        res = subprocess.run(with_helpers(command, scripts_dir), shell=True, executable="/bin/bash")
    except KeyboardInterrupt:
        return 130
    print()
    if res.returncode == 0:
        learned_path = os.path.expanduser(config.get("learned_dataset", "~/.local/share/termy/dataset_learned.json"))
        learned.save_entry(learned_path, user_input, command, explanation)
        on_demand.stop_server()  # the server loads the new entry on its next start
        print(f"{GRAY}Saved: TERMy will answer this prompt by itself next time.{RESET}\n")
    return res.returncode

def print_dry_run(result: dict, command: str, description: str, note: str = "") -> int:
    """Prints what TERMy matched and would run, without running it."""
    confidence = result.get("confidence", 0.0) * 100
    print(f"{YELLOW}Dry run: nothing was executed{RESET}\n")
    print(f"Status: {result.get('status', 'rejected')} | Confidence: {confidence:.2f}\n")
    if note:
        print(f"{note} TERMy would ask the LLM.\n")
    if result.get("response"):
        print(f"Response: {result['response']}\n")
    if command:
        permission = result.get("permission", "ask")
        runs = "runs without asking" if permission == "yolo" else "asks first"
        print(f"Permission: {permission} ({runs})\n")
        print(f"{GREEN}{BOLD}{command}{RESET}")
    if description.strip():
        print(f"{GRAY}\nDescription: {description.strip()}{RESET}")
    related = [intent["input"][0] for intent in result.get("related", [])]
    if related:
        print(f"\nRelated: {', '.join(related)}")
    print()
    return 0

def run_cli() -> int:
    usage_text = '\n termy [OPTIONS] "hello"\n termy [OPTIONS] hello\n echo "hello" | termy [OPTIONS]\n termy -y < test.termy\n'
    
    parser = argparse.ArgumentParser(
        description="TERMy - Terminal assistant and plain English to Bash transpiler.",
        usage=usage_text,
    )
    
    parser.add_argument(
        "query", 
        nargs="*", 
        help="Prompt input string."
    )
    
    parser.add_argument(
        "--npc", 
        default="termy", 
        help="Target NPC instance (default: termy)"
    )
    
    parser.add_argument(
        "-y", "--yes", 
        action="store_true", 
        help="Automatically answer yes to prompts (skip confirmation)"
    )
    
    parser.add_argument(
        "-n", "--dry-run",
        action="store_true",
        help="Show the matched command without running it"
    )

    parser.add_argument(
        "-v", "--verbose", 
        action="store_true", 
        help="Show debugging information"
    )
    
    args = parser.parse_args()
    
    print()

    if not sys.stdin.isatty(): user_input = sys.stdin.read().strip()
    elif args.query: user_input = " ".join(args.query).strip()
    else: parser.error("Provide input via arguments or pipe!\n")
    if not user_input: parser.error("The query must not be empty!\n")

    # Pass --yes flag through environment so all subprocess calls inherit it
    if args.yes: os.environ["TERMY_YES"] = "1"

    # Use the on-demand server when it runs; otherwise answer locally and start it
    CURRENT_BOT_DIR = Path(os.path.realpath(__file__)).parent
    local = LocalProvider(str(CURRENT_BOT_DIR.parent.parent), CURRENT_BOT_DIR)
    result = on_demand.ask(args.npc, user_input, local, start=not args.dry_run)

    emoji = result.get("emoji", "")
    if emoji == "😑": emoji = ""
            
    response = result.get("response", "")
    status = str(result.get("status", "rejected")).lower()
    confidence = result.get("confidence", 0.0)
    tools = result.get("tools", [])
    command = ""
    description = ""

    CURRENT_BOT_DIR = Path(os.path.realpath(__file__)).parent
    home_dir = os.path.expanduser("~")
    config_path = os.path.join(home_dir, ".local/share/termy/")
    config = load_json(CURRENT_BOT_DIR, "config.json")
    context = load_json(config_path, "config.json")    
        
    permission = result.get("permission", "ask")
    thinking = result.get("thinking", "")
    
    # Confidence color coding representation output
    conf_color = GREEN if confidence > 0.7 else (
        YELLOW if confidence > 0.5 else RED
    )
    
    meta = (
        f"{GREEN}{BOLD}{config.get('npc_name', '')}{RESET} | "
        f"{status} | "
        f"Confidence: {conf_color}{confidence * 100:.2f}{RESET}\n"
    )
    
    if args.verbose: print(meta)
    if thinking: print(f"{GRAY}Thinking: " + thinking + RESET + "\n")
    
    if tools:
        for tool_group in tools:
            if not tool_group: continue
            if isinstance(tool_group, dict):
                tool_group = [tool_group]
                
            for tool_data in tool_group:
                if not tool_data or not isinstance(tool_data, dict): continue
                tool_args = tool_data.get("arguments", {})
                
                if "command" in tool_args:
                    if command: 
                        command += " && "
                    command += tool_args["command"]
                
                if "explanation" in tool_args or "description" in result:
                    description += " " + tool_args.get(
                        "explanation", result.get("description", "")
                    )

    llm_config = config.get("llm", {})
    uncertain = llm_config.get("enabled", False) and is_uncertain(
        result, float(llm_config.get("uncertain_below", 0.8))
    )

    # Return before TTS, the related-intents menu, LLM generation and execution
    if args.dry_run:
        return print_dry_run(result, command, description, uncertainty_note(result) if uncertain else "")

    # No match or an uncertain match: ask the LLM; continue as before when LM Studio is missing
    if uncertain:
        yes = args.yes or os.environ.get("TERMY_YES") == "1"
        code = llm_fallback(llm_config, config, user_input, result, CURRENT_BOT_DIR / "scripts", yes)
        if code is not None:
            return code

    if response: 
        print(f"Response: {response} {emoji}\n")
        
        # Speak response immediately if TTS is on
        if context.get("tts", "") == "on":
            try:
                subprocess.run(
                    f"pkill -9 -x {config.get('tts', '')}", 
                    shell=True, 
                    stdout=subprocess.DEVNULL, 
                    stderr=subprocess.DEVNULL
                )
                clean_response = (
                    "'" + response.replace('"', '').replace("'", "") + "'"
                )
                subprocess.Popen(
                    [config.get("tts", ""), clean_response],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True
                )
            except Exception as e:
                sys.stderr.write(f"Audio playback failed: {e}\n")

    if description: 
        description = GRAY + f"\n\nDescription: {description.strip()}\n" + RESET
    
    if command:
        print(f"{GREEN}{BOLD}{command}{RESET}{description}")

    # No match: offer the related intents
    related = result.get("related", [])
    if status == "rejected" and related:
        related_intents = [intent["input"][0] for intent in related]
        menu_text = f"Digit {GREEN}{BOLD}1-{len(related)}{RESET} or {GREEN}{BOLD}q{RESET} to quit\n"
        choice = tui.multi_choice("Select an intent", related_intents, menu_text, 'a')
        if isinstance(choice, int) and 0 < choice <= len(related):
            try:
                res = subprocess.run(
                    [sys.argv[0], related_intents[choice - 1]],
                    executable=sys.argv[0]
                )
                return res.returncode
            except KeyboardInterrupt:
                print(f"\n\n{YELLOW}Execution cancelled.{RESET}\n")
                return 130
            except Exception as exc:
                print(f"\n\nFailed to execute recursive call: {exc}\n")
                return 1
        return 0

    # ==========================================
    # STANDARD EXECUTION PATH
    # ==========================================
    if command:
        scripts_dir = CURRENT_BOT_DIR / "scripts"
        sources = []
        
        # Scan scripts directory to find all .sh script files
        if scripts_dir.is_dir():
            for file in sorted(scripts_dir.iterdir()):
                if file.suffix == ".sh":
                    sources.append(f"source {file}")
        
        if sources: 
            command = f"{' && '.join(sources)} && {command}"
    
        if permission == "yolo" or args.yes or os.environ.get("TERMY_YES") == "1" or tui.confirm():
            try:
                res = subprocess.run(
                    command, 
                    shell=True, 
                    executable="/bin/bash",
                    check=True    
                )
                print()
                return res.returncode
            except subprocess.CalledProcessError as e:
                if args.verbose:
                    sys.stderr.write(f"{RED}Command failed, exit code: {e.returncode}{RESET}\n\n")
                return e.returncode
            except KeyboardInterrupt:
                if args.verbose: 
                    print(f"{YELLOW}Execution cancelled.{RESET}\n")
                return 130
            except Exception as exc:
                print(f"Failed to execute command: {exc}\n")
                return 1
                
    return 0

if __name__ == "__main__":
    raise SystemExit(run_cli())