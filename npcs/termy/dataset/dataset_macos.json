[
    {
        "category": "macos_git_commit_all",
        "input": [
            "commit everything",
            "commit all changes",
            "commit all my changes",
            "commit my changes",
            "git commit all"
        ],
        "tools": [
            {
                "name": "run_in_terminal",
                "arguments": {
                    "command": "termy_question \"Commit message\" msg && git add -A && git commit -m \"$msg\"",
                    "explanation": "Stages every change, then commits with the message you type.",
                    "goal": "Commit all changes",
                    "mode": "sync"
                }
            }
        ],
        "permission": "ask"
    },
